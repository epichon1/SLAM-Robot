<?xml version="1.0"?>
<!-- Minimal stand-in for bot_description/urdf/vertex.urdf.xacro, which is not
     part of the vertex_planning repo.  The dimensions match the kinematic
     constants in packages/odom_vertex.py: wheel radius 0.4064 m, track width
     1.2446 m, wheelbase 1.6256 m.  The root link is 'world', the frame that
     odom_vertex.py broadcasts as the child of 'odom'. -->
<robot name="vertex">

  <material name="body">  <color rgba="0.20 0.45 0.75 1.0"/></material>
  <material name="rubber"><color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="nose">  <color rgba="0.95 0.65 0.10 1.0"/></material>

  <link name="world"/>

  <!-- 'base' is the frame the planner looks up for its own pose. -->
  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child  link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base"/>

  <joint name="chassis_joint" type="fixed">
    <parent link="base"/>
    <child  link="chassis"/>
    <origin xyz="0 0 0.4064" rpy="0 0 0"/>
  </joint>
  <link name="chassis">
    <visual>
      <geometry><box size="1.6256 1.2446 0.35"/></geometry>
      <material name="body"/>
    </visual>
  </link>

  <joint name="nose_joint" type="fixed">
    <parent link="chassis"/>
    <child  link="nose"/>
    <origin xyz="0.85 0 0" rpy="0 1.5708 0"/>
  </joint>
  <link name="nose">
    <visual>
      <geometry><cylinder radius="0.12" length="0.20"/></geometry>
      <material name="nose"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child  link="lidar"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>
  <link name="lidar">
    <visual>
      <geometry><cylinder radius="0.09" length="0.10"/></geometry>
      <material name="rubber"/>
    </visual>
  </link>

  <joint name="front_left_wheel_joint" type="fixed">
    <parent link="base"/><child link="front_left_wheel"/>
    <origin xyz="0.8128 0.6223 0.4064" rpy="1.5708 0 0"/>
  </joint>
  <link name="front_left_wheel">
    <visual><geometry><cylinder radius="0.4064" length="0.20"/></geometry>
      <material name="rubber"/></visual>
  </link>

  <joint name="front_right_wheel_joint" type="fixed">
    <parent link="base"/><child link="front_right_wheel"/>
    <origin xyz="0.8128 -0.6223 0.4064" rpy="1.5708 0 0"/>
  </joint>
  <link name="front_right_wheel">
    <visual><geometry><cylinder radius="0.4064" length="0.20"/></geometry>
      <material name="rubber"/></visual>
  </link>

  <joint name="rear_left_wheel_joint" type="fixed">
    <parent link="base"/><child link="rear_left_wheel"/>
    <origin xyz="-0.8128 0.6223 0.4064" rpy="1.5708 0 0"/>
  </joint>
  <link name="rear_left_wheel">
    <visual><geometry><cylinder radius="0.4064" length="0.20"/></geometry>
      <material name="rubber"/></visual>
  </link>

  <joint name="rear_right_wheel_joint" type="fixed">
    <parent link="base"/><child link="rear_right_wheel"/>
    <origin xyz="-0.8128 -0.6223 0.4064" rpy="1.5708 0 0"/>
  </joint>
  <link name="rear_right_wheel">
    <visual><geometry><cylinder radius="0.4064" length="0.20"/></geometry>
      <material name="rubber"/></visual>
  </link>

</robot>
